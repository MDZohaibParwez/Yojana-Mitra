# ---- Database (Neon / Supabase Postgres with pgvector) ----
# Use the POOLED connection string on Vercel (Neon "-pooler" host, Supabase port 6543).
DATABASE_URL=postgres://ym:ym@localhost:5432/yojana_mitra
DB_POOL_MAX=5

# ---- Admin API ----
# Comma-separated sha256 hashes of admin API keys (generate: pnpm --filter @ym/api admin:key)
ADMIN_API_KEY_HASHES=
# Secret for signing short-lived admin JWTs (min 32 chars)
ADMIN_JWT_SECRET=

# ---- Public API / web ----
PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60

# ---- LLM-assisted ingestion (rule extraction + translation). Output is always saved as pending. ----
ANTHROPIC_API_KEY=
INGEST_MODEL=claude-opus-5-5

# ---- Semantic search embeddings (optional; FTS works without it) ----
# Any OpenAI-compatible /embeddings endpoint serving a 1024-dim multilingual model (e.g. bge-m3, multilingual-e5-large).
EMBEDDINGS_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# ---- WhatsApp Business Cloud API ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# HMAC key used to derive anonymous session keys from phone numbers (min 32 chars)
SESSION_HMAC_KEY=
SESSION_TTL_MINUTES=60

# ---- Speech-to-text for voice notes ----
# provider: sarvam | openai-compatible
STT_PROVIDER=sarvam
STT_API_KEY=
STT_URL=

# ---- Misc ----
CRON_SECRET=                       # Vercel Cron bearer secret for /admin/v1/cron/cleanup
PRIVACY_POLICY_URL=https://yojanamitra.example/privacy
ADMIN_RATE_LIMIT_PER_MINUTE=300
MCP_RATE_LIMIT_PER_MINUTE=120
WHATSAPP_GRAPH_VERSION=v21.0
STT_MODEL=
# Local development without Postgres: serve the curated seed from memory (refused when NODE_ENV=production)
YM_DEV_SEED=
# Integration tests (database name must contain "test"; it is wiped)
TEST_DATABASE_URL=postgres://ym:ym@localhost:5432/yojana_mitra_test
