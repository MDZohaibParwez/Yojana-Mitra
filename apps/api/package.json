{
  "name": "@ym/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "admin:key": "tsx src/cli/admin-key.ts",
    "openapi": "tsx src/cli/export-openapi.ts",
    "build:vercel": "node ../../scripts/vercel-build.mjs . --max-duration 30 --cron \"/admin/v1/cron/cleanup|23 3 * * *\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@ym/core": "workspace:*",
    "@ym/db": "workspace:*",
    "hono": "^4.10.4",
    "zod": "^4.6.6",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}